# ---------------------------------------------------------------------------
# messages, cleanup and locking

function warn {
  # red only when a human is looking at stderr
  if [[ -t 2 ]]
  then
    printf '\e[1;31m%s\e[m\n' "$*" >&2
  else
    printf '%s\n' "$*" >&2
  fi
}

function die {
  warn "$@"
  exit 1
}

function log-action {
  local ts
  printf -v ts '%(%F %T)T' -1
  mkdir -p -- "${LOGFILE%/*}" 2>/dev/null &&
    printf '%s %s\n' "$ts" "$*" >> "$LOGFILE" 2>/dev/null
  return 0
}

function cleanup {
  if [[ $LOCKED && $(cat -- "$LOCKDIR/pid" 2>/dev/null) == "$$" ]]
  then
    rm -f -- "$LOCKDIR/pid"
    rmdir -- "$LOCKDIR" 2>/dev/null
  fi
  [[ $TMPD ]] && rm -rf -- "$TMPD"
  return 0
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

function acquire-lock {
  mkdir -p -- "$SETUP" || die "cannot create $SETUP"
  if ! mkdir -- "$LOCKDIR" 2>/dev/null
  then
    die "another apt-cyg owns $LOCKDIR (pid $(cat -- "$LOCKDIR/pid" 2>/dev/null)); if stale, verify the process has exited before removing the lock"
  fi
  printf '%s\n' "$$" > "$LOCKDIR/pid" || { rmdir -- "$LOCKDIR"; die 'cannot record lock owner'; }
  LOCKED=1
}

function confirm {
  # never block scripts, pipes or --yes
  [[ -v yes || ! -t 0 || ! -t 1 ]] && return 0
  local answer
  read -r -p 'Do you want to continue? [Y/n] ' answer
  [[ -z $answer || $answer == [Yy]* ]]
}

function check-packages {
  if (( ${#pks[@]} ))
  then
    return 0
  else
    warn No packages found.
    return 1
  fi
}

function in-list {
  # in-list WORD LIST: whole-word membership in a space separated list
  [[ " ${2//$'\n'/ } " == *" $1 "* ]]
}

# ---------------------------------------------------------------------------
# downloading

function downloader {
  if [[ ! $DOWNLOADER ]]
  then
    if [[ $APT_CYG_DOWNLOADER ]]
    then
      DOWNLOADER=$APT_CYG_DOWNLOADER
    elif command -v wget >/dev/null
    then
      DOWNLOADER=wget
    elif command -v curl >/dev/null
    then
      DOWNLOADER=curl
    elif command -v lynx >/dev/null
    then
      DOWNLOADER=lynx
    else
      DOWNLOADER=none
    fi
  fi
  echo "$DOWNLOADER"
}

function wget-has-compression {
  # --compression appeared in wget 1.19.2, probe it once
  if [[ ! $WGET_COMPRESSION ]]
  then
    command wget --help 2>&1 | grep -q -- --compression &&
      WGET_COMPRESSION=yes || WGET_COMPRESSION=no
  fi
  [[ $WGET_COMPRESSION == yes ]]
}

function fetch-once {
  # fetch URL DEST [text]: download through a temp name so a broken
  # transfer never leaves a truncated file under the real name
  local url=$1 out=$2 part=$2.part.$$ rc opts
  [[ ! -v verbose ]] || printf 'Downloader: %s\n' "$(downloader)" >&2
  case $url in
    file://*)
      cp -- "${url#file://}" "$part" ;;
    /*)
      cp -- "$url" "$part" ;;
    *)
      case $(downloader) in
        wget)
          opts=(--timeout="${APT_CYG_TIMEOUT:-30}" --tries=1 -O "$part")
          if [[ -v quiet ]]; then opts+=(-q)
          elif [[ -t 2 && ! -v no_progress ]]; then opts+=(--progress=bar)
          else opts+=(-nv); fi
          # gzip transfer helps plain text only, packages are xz/zst already
          # and a Content-Encoding on them could break the checksum
          [[ $3 == text ]] && wget-has-compression && opts+=(--compression=auto)
          command wget "${opts[@]}" "$url" ;;
        curl)
          opts=(-fL --max-time "${APT_CYG_TIMEOUT:-30}" -o "$part")
          [[ -t 2 && ! -v quiet && ! -v no_progress ]] || opts+=(-sS)
          [[ $3 == text ]] && opts+=(--compressed)
          command curl "${opts[@]}" "$url" ;;
        lynx)
          # lynx has no -O, so redirect explicitly instead of guessing a name
          command lynx -connect_timeout="${APT_CYG_TIMEOUT:-30}" -source "$url" > "$part" ;;
        *)
          warn 'no downloader found, install wget, curl or lynx'
          false ;;
      esac ;;
  esac
  rc=$?
  if (( rc == 0 )) && [[ -e $part ]]
  then
    mv -f -- "$part" "$out"
  else
    rm -f -- "$part"
    return 1
  fi
}

function fetch {
  local method
  case $1 in file://*|/*) fetch-once "$@"; return $? ;; esac
  if [[ $APT_CYG_DOWNLOADER ]]
  then
    fetch-once "$@"
    return $?
  fi
  for method in wget curl lynx
  do
    command -v "$method" >/dev/null || continue
    DOWNLOADER=$method fetch-once "$@" && return 0
  done
  warn "download failed: $1"
  return 1
}

function verify-hash {
  # verify-hash FILE DIGEST: the digest length tells the algorithm
  local f=$1 d=$2 tool sum
  case ${#d} in
     32) tool=md5sum    ;;
     64) tool=sha256sum ;;
    128) tool=sha512sum ;;
      *) warn "no usable checksum for ${f##*/}"; return 1 ;;
  esac
  # read from stdin so file names with spaces cannot confuse the tool
  sum=$("$tool" < "$f") || return 1
  [[ ${sum%% *} == "$d" ]]
}

function urlencode {
  local LC_ALL=C s=$1 i c out=
  for (( i = 0; i < ${#s}; i++ ))
  do
    c=${s:i:1}
    case $c in
      [a-zA-Z0-9._~-]) out+=$c ;;
      *) printf -v c '%%%02X' "'$c"; out+=$c ;;
    esac
  done
  echo "$out"
}

# ---------------------------------------------------------------------------
# setup.rc, workspace and setup.ini

function rc-get {
  [[ -f $RC ]] || return 1
  # a key line is followed by its tab indented value
  key=$1 gawk '
  $0 == ENVIRON["key"] {
    getline
    sub(/^\t/, "")
    print
    exit
  }
  ' "$RC"
}

function rc-set {
  mkdir -p -- "$SETUP" && touch -- "$RC" || return 1
  # values travel through ENVIRON, -v would eat the backslashes of C:\path
  key=$1 val=$2 gawk '
  skip && /^\t/ { next }
  { skip = 0 }
  $0 == ENVIRON["key"] {
    print
    print "\t" ENVIRON["val"]
    skip = found = 1
    next
  }
  1
  END {
    if (! found) {
      print ENVIRON["key"]
      print "\t" ENVIRON["val"]
    }
  }
  ' "$RC" > "$RC.tmp.$$" && mv -f -- "$RC.tmp.$$" "$RC"
}

function find-workspace {
  # find-workspace [soft]: soft returns 1 instead of dying when unconfigured
  local soft=$1
  [[ $archdir ]] && return 0
  cache=${cache_override:-$(rc-get last-cache)}
  mirror=${mirror_override:-$(rc-get last-mirror)}
  if [[ ! $cache || ! $mirror ]]
  then
    [[ $soft ]] && return 1
    die "no cache or mirror configured; run setup.exe once, or use" \
        "'apt-cyg cache DIR' and 'apt-cyg mirror URL'"
  fi
  # setup.rc holds a windows path, cygwin tools want a posix one
  if [[ $cache == *\\* || $cache == ?:* ]] && command -v cygpath >/dev/null
  then
    cache=$(cygpath -u "$cache")
  fi
  # same encoding setup.exe uses, so both tools share one download cache
  mirrordir=$(sed '
  s / %2f g
  s : %3a g
  ' <<< "$mirror")
  mirrorurl=${mirror%/}
  cachedir=$cache/$mirrordir
  archdir=$cachedir/$arch
  mkdir -p -- "$archdir" || die "cannot create $archdir"
  if [[ ! -s $archdir/setup.ini && ! $no_auto_setup ]]
  then
    get-setup || { [[ $soft ]] && return 1; die "cannot get setup.ini from $mirror"; }
  fi
  if [[ ! $no_auto_setup && ! $METADATA_VERIFIED ]]
  then
    verify-cached-metadata || get-setup || die 'package metadata could not be verified'
    METADATA_VERIFIED=1
  fi
  return 0
}

function decompress-metadata {
  case $1 in
    *.zst) zstd -dc -- "$1" ;;
    *.xz) xz -dc -- "$1" ;;
    *.bz2) bzip2 -dc -- "$1" ;;
    *.gz) gzip -dc -- "$1" ;;
    *) cat -- "$1" ;;
  esac
}

function prepare-keyring {
  command -v gpg >/dev/null || { warn 'gnupg is required for signature verification'; return 1; }
  if [[ -e $KEYRING ]]
  then
    [[ -s $KEYRING ]] && return 0
    warn 'trusted keyring is empty; explicitly add a trusted key'
    return 1
  fi
  if [[ $APT_CYG_KEYRING ]]
  then
    warn "trusted keyring does not exist: $KEYRING"
    return 1
  fi
  local public_key=$TMPD/cygwin-key.asc fingerprint
  fetch https://cygwin.com/key/pubring.asc "$public_key" || return 1
  fingerprint=$(gpg --batch --homedir "$TMPD/gpg" --with-colons --show-keys "$public_key" 2>/dev/null |
    gawk -F: '$1 == "fpr" { print $10 }') || return 1
  in-list "$CYGWIN_FINGERPRINT" "$fingerprint" || { warn 'Cygwin signing key fingerprint mismatch'; return 1; }
  # Export only the pinned primary key, never additional keys from the download.
  gpg --batch --homedir "$TMPD/gpg" --import "$public_key" >/dev/null 2>&1 || return 1
  gpg --batch --homedir "$TMPD/gpg" --export "$CYGWIN_FINGERPRINT" > "$KEYRING.tmp.$$" || return 1
  mv -f -- "$KEYRING.tmp.$$" "$KEYRING"
}

function verify-signature {
  if [[ -v no_verify ]]
  then
    warn 'Signature verification explicitly disabled (--no-verify)'
    return 0
  fi
  prepare-keyring || return 1
  gpg --batch --homedir "$TMPD/gpg" --no-default-keyring --keyring "$KEYRING" \
    --verify "$2" "$1" || { warn "signature verification failed: ${1##*/}"; return 1; }
}

function verify-cached-metadata {
  [[ -v no_verify ]] && return 0
  local source
  read -r source < "$archdir/setup.signed-source" 2>/dev/null || return 1
  case $source in setup.ini|setup.zst|setup.xz|setup.bz2|setup.gz) ;; *) return 1 ;; esac
  [[ $source == setup.ini ]] && source=setup.signed.ini
  verify-signature "$archdir/$source" "$archdir/$source.sig" || return 1
  decompress-metadata "$archdir/$source" | cmp -s - "$archdir/setup.ini"
}

function get-setup {
  local ext tool source= candidate=$TMPD/setup candidate_sig=$TMPD/setup.sig old_stamp new_stamp
  for ext in zst xz bz2 gz ini
  do
    case $ext in
      zst) tool=zstd ;; xz) tool=xz ;; bz2) tool=bzip2 ;; gz) tool=gzip ;; ini) tool=cat ;;
    esac
    command -v "$tool" >/dev/null || continue
    candidate=$TMPD/setup.$ext
    if ! fetch "$mirrorurl/$arch/setup.$ext" "$candidate"
    then
      continue
    fi
    if [[ ! -v no_verify ]]
    then
      fetch "$mirrorurl/$arch/setup.$ext.sig" "$candidate_sig" || return 1
      verify-signature "$candidate" "$candidate_sig" || return 1
    fi
    source=setup.$ext
    break
  done
  [[ $source ]] || { warn 'cannot download package metadata; keeping previous metadata'; return 1; }
  decompress-metadata "$candidate" > "$TMPD/setup.decoded.ini" || return 1
  grep -q '^@ ' "$TMPD/setup.decoded.ini" || { warn 'invalid package metadata'; return 1; }
  old_stamp=$(gawk '$1 == "setup-timestamp:" { print $2; exit }' "$archdir/setup.ini" 2>/dev/null)
  new_stamp=$(gawk '$1 == "setup-timestamp:" { print $2; exit }' "$TMPD/setup.decoded.ini")
  if [[ $old_stamp =~ ^[0-9]+$ ]] && { [[ ! $new_stamp =~ ^[0-9]+$ ]] || (( new_stamp < old_stamp )); }
  then
    warn 'refusing older package metadata; previous metadata retained'
    return 1
  fi
  [[ $source == setup.ini ]] && source=setup.signed.ini
  if [[ ! -v no_verify ]]
  then
    cp -- "$candidate" "$archdir/$source" || return 1
    cp -- "$candidate_sig" "$archdir/$source.sig" || return 1
  fi
  printf '%s\n' "${source/setup.signed.ini/setup.ini}" > "$archdir/setup.signed-source" || return 1
  if ! cmp -s "$TMPD/setup.decoded.ini" "$archdir/setup.ini"
  then
    [[ ! -f $archdir/setup.ini ]] || cp -p -- "$archdir/setup.ini" "$archdir/setup.ini-save" || return 1
    cp -- "$TMPD/setup.decoded.ini" "$archdir/setup.ini.tmp.$$" || return 1
    mv -f -- "$archdir/setup.ini.tmp.$$" "$archdir/setup.ini" || return 1
    rm -f -- "$archdir/setup.idx"
  fi
  echo "Updated setup.ini (from $source)"
}

# Cached package metadata, read once per command.
IDX_AWK='
function deplist(s,    n, i, a, out) {
  gsub(/\([^)]*\)/, "", s)
  # The raw expression is retained separately for rejection by the solver.
  # Do not let an alternative operator become an index field separator.
  gsub(/\|/, " ", s)
  n = split(s, a, /[ ,]+/)
  out = ""
  for (i = 1; i <= n; i++)
    if (a[i] != "") out = out (out == "" ? "" : " ") a[i]
  return out
}
function reset_version() {
  file = size = hash = ver = req = relation = srfile = srsize = srhash = ""
  modern_seen = 0
}
function version_flush(    filename, dependencies, raw) {
  if (file == "") return
  filename = file
  sub(/^.*\//, "", filename)
  if ((ENVIRON["wanted_archive"] != "" && name == ENVIRON["wanted_package"] && filename == ENVIRON["wanted_archive"]) ||
      (ENVIRON["wanted_archive"] == "" && curr)) {
    raw = modern_seen ? relation : (req != "" ? req : base_requires)
    dependencies = deplist(raw)
    gsub(/\|/, "%7C", raw)
    chosen = name OFS file OFS size OFS hash OFS ver OFS dependencies OFS cats OFS raw OFS srfile OFS srsize OFS srhash
  }
}
function flush() {
  version_flush()
  if (chosen != "") print chosen
}
BEGIN { OFS = "|"; print "#apt-cyg-index", "3" }
inq {
  if (gsub(/"/, "&") % 2) inq = 0
  next
}
/^@ / {
  flush()
  name = $2
  cats = chosen = base_requires = ""
  version_seen = 0
  curr = 1
  reset_version()
  next
}
name == "" { next }
/^\[/ {
  version_flush()
  reset_version()
  curr = ($0 ~ /^\[curr\][[:space:]]*$/)
  version_seen = 1
  next
}
$1 == "version:" { version_seen = 1; ver = $2 }
$1 == "install:" { file = $2; size = $3; hash = $4 }
$1 == "source:" { srfile = $2; srsize = $3; srhash = $4 }
$1 == "requires:" {
  if (!version_seen) base_requires = substr($0, 10)
  else req = substr($0, 10)
}
$1 ~ /^(depends2|depends):$/ {
  relation = substr($0, index($0, ":") + 1)
  modern_seen = 1
}
$1 == "category:" { cats = substr($0, 10); sub(/^ +/, "", cats) }
{ if (gsub(/"/, "&") % 2) inq = 1 }
END { flush() }
'

function select-installed-version {
  local p=$1 record n f size h v d c relation sf ss sh
  record=$(wanted_package="$p" wanted_archive="${INST_FILE[$p]}" gawk "$IDX_AWK" "$archdir/setup.ini" | tail -n +2)
  [[ $record ]] || { warn "authenticated metadata for installed version of $p is unavailable; use Cygwin Setup"; return 1; }
  IFS='|' read -r n f size h v d c relation sf ss sh <<< "$record"
  IDX_FILE[$p]=$f
  IDX_HASH[$p]=$h
  IDX_VER[$p]=$v
  IDX_DEPS[$p]=$d
  IDX_CAT[$p]=$c
  IDX_REL[$p]=${relation//%7C/|}
}

function build-index {
  local idx=$archdir/setup.idx hdr
  # reuse the index until setup.ini changes
  if [[ -s $idx && ! $archdir/setup.ini -nt $idx ]] && read -r hdr < "$idx" &&
     [[ $hdr == "$IDX_MAGIC" ]]
  then
    return 0
  fi
  gawk "$IDX_AWK" "$archdir/setup.ini" > "$idx.tmp.$$" &&
    mv -f -- "$idx.tmp.$$" "$idx" || { rm -f -- "$idx.tmp.$$"; return 1; }
}

function load-index {
  [[ $INDEX_LOADED ]] && return 0
  build-index || die 'cannot build the package index'
  local n f s h v d c relation sf ss sh
  # '|' rather than tab: a non-blank IFS keeps empty fields in place
  while IFS='|' read -r n f s h v d c relation sf ss sh
  do
    [[ $n == '#'* ]] && continue
    IDX_FILE[$n]=$f
    IDX_HASH[$n]=$h
    IDX_VER[$n]=$v
    IDX_DEPS[$n]=$d
    IDX_CAT[$n]=$c
    IDX_REL[$n]=${relation//%7C/|}
    IDX_SIZE[$n]=$s
    IDX_SOURCE[$n]=$sf IDX_SOURCE_SIZE[$n]=$ss IDX_SOURCE_HASH[$n]=$sh
  done < "$archdir/setup.idx"
  INDEX_LOADED=1
  [[ ! $DB_LOADED ]] || load-installed-dependencies
}

function in-index {
  [[ -n ${IDX_FILE[$1]} ]]
}

# ---------------------------------------------------------------------------
# installed.db

function load-db {
  [[ $DB_LOADED ]] && return 0
  local n f flag first=1
  if [[ -f $DB ]]
  then
    while read -r n f flag _
    do
      if (( first ))
      then
        first=0
        if [[ $n == INSTALLED.DB ]]
        then
          DB_HEADER="$n $f"
          continue
        fi
      fi
      [[ $n ]] || continue
      INST_FILE[$n]=$f
      INST_FLAG[$n]=${flag:-0}
    done < "$DB"
  fi
  if [[ ! -f $TRACKING ]]
  then
    for n in "${!INST_FILE[@]}"; do INST_FLAG[$n]=1; done
  fi
  load-installed-dependencies
  DB_LOADED=1
}



function save-db {
  local tmp=$DB.tmp.$$ p
  mkdir -p -- "$SETUP"
  {
    # the header must stay on line one, so only the body is sorted;
    # the third field is setup.exe's "picked by the user" flag
    printf '%s\n' "$DB_HEADER"
    for p in "${!INST_FILE[@]}"
    do
      printf '%s %s %s\n' "$p" "${INST_FILE[$p]}" "${INST_FLAG[$p]:-0}"
    done | LC_ALL=C sort
  } > "$tmp" || { rm -f -- "$tmp"; die "cannot write $DB"; }
  [[ -f $DB ]] && cp -p -- "$DB" "$DB-save"
  # rename is atomic, a crash never leaves a half-written database
  mv -f -- "$tmp" "$DB" || return 1
  printf '1\n' > "$TRACKING"
}


function load-installed-dependencies {
  local p deps recorded
  for p in "${!INST_FILE[@]}"
  do
    if [[ -f $SETUP/$p.deps ]] && read -r recorded < "$SETUP/$p.deps" && [[ $recorded == "${INST_FILE[$p]}" ]]
    then
      INST_DEPS[$p]=$(tail -n +2 -- "$SETUP/$p.deps")
      INST_KNOWN[$p]=1
    elif [[ ${INST_FILE[$p]} == "${IDX_FILE[$p]##*/}" && -n ${IDX_FILE[$p]} ]]
    then
      INST_DEPS[$p]=${IDX_DEPS[$p]}
      INST_KNOWN[$p]=1
    elif [[ $INDEX_LOADED ]]
    then
      deps=$(wanted_package="$p" wanted_archive="${INST_FILE[$p]}" gawk "$IDX_AWK" "$archdir/setup.ini" | tail -n +2)
      if [[ $deps ]]
      then
        IFS="|" read -r _ _ _ _ _ deps _ <<< "$deps"
        INST_DEPS[$p]=$deps
        INST_KNOWN[$p]=1
      fi
    fi
  done
}

function validate-dependencies {
  local p=$1 d
  if [[ ${IDX_REL[$p]} == *['()|']* ]]
  then
    warn "versioned or alternative dependencies for $p require Cygwin Setup: ${IDX_REL[$p]}"
    return 1
  fi
  for d in ${IDX_DEPS[$p]}
  do
    [[ $d =~ ^[A-Za-z0-9_+.-]+$ ]] || { warn "invalid dependency for $p: $d"; return 1; }
  done
}

function is-installed {
  [[ -n ${INST_FILE[$1]} ]]
}

function file-version {
  # file-version PKG FILE: pkg-1.2-3.tar.xz -> 1.2-3
  local b=${2##*/}
  b=${b%.tar.*}
  echo "${b#"$1"-}"
}

function is-upgradable {
  # setup.exe semantics: "current" differs from what is installed
  is-installed "$1" && in-index "$1" &&
    [[ ${INST_FILE[$1]} != "${IDX_FILE[$1]##*/}" ]]
}

function sorted-installed {
  (( ${#INST_FILE[@]} )) && printf '%s\n' "${!INST_FILE[@]}" | LC_ALL=C sort
}

function is-essential {
  local p=$1
  in-list "$p" "$ESSENTIAL_PKGS" && return 0
  # on a live system also protect packages owning a dll the core tools load
  if [[ -z $ROOT && -f $SETUP/$p.lst.gz ]] && command -v cygcheck >/dev/null
  then
    if [[ ! $ESS_DLLS ]]
    then
      ESS_DLLS=$(cygcheck awk bash bunzip2 grep gzip mv sed tar xz 2>/dev/null |
        gawk -F'[/\\\\]' 'tolower($NF) ~ /\.dll$/ { print tolower($NF) }' | sort -u)
    fi
    gzip -cd -- "$SETUP/$p.lst.gz" | ESS_DLLS=$ESS_DLLS gawk -F/ '
    BEGIN {
      n = split(ENVIRON["ESS_DLLS"], a, "\n")
      for (i = 1; i <= n; i++) ess[a[i]]
    }
    tolower($NF) in ess { hit = 1; exit }
    END { exit ! hit }
    ' && return 0
  fi
  return 1
}

# ---------------------------------------------------------------------------
# scripts

function run-script {
  local s=$1 rc
  echo "Running ${s##*/}"
  case $s in
    *.sh)
      ( cd -- "$ROOT/" && command bash --norc --noprofile "$s" ) ;;
    *.dash)
      if command -v dash >/dev/null
      then
        ( cd -- "$ROOT/" && command dash "$s" )
      else
        ( cd -- "$ROOT/" && command sh "$s" )
      fi ;;
    *.bat | *.cmd)
      if command -v cmd >/dev/null && command -v cygpath >/dev/null
      then
        ( cd -- "$ROOT/" && command cmd /c "$(cygpath -w "$s")" )
      else
        warn "cannot run ${s##*/}: cmd.exe not available"
        return 1
      fi ;;
  esac
  rc=$?
  (( rc )) && warn "${s##*/} exited with status $rc"
  return $rc
}

function run-postinstall {
  local list s rc=0
  if [[ -v noscripts ]]
  then
    echo 'Skipping postinstall scripts (--noscripts)'
    return 0
  fi
  [[ -d $POSTINSTALL ]] || return 0
  # setup.exe order: 0p_ perpetual, then one-shot scripts, then zp_ perpetual;
  # .dash matters most: autorebase ships as a perpetual .dash script
  mapfile -t list < <(
    cd -- "$POSTINSTALL" &&
    for s in *.sh *.dash *.bat *.cmd
    do
      [[ -f $s ]] && printf '%s\n' "$s"
    done | gawk '{ print (/^0p_/ ? 0 : /^zp_/ ? 2 : 1) "\t" $0 }' |
      LC_ALL=C sort | cut -f2-
  )
  for s in "${list[@]}"
  do
    if run-script "$POSTINSTALL/$s"
    then
      # perpetual scripts must run after every install, never mark them done
      case $s in
        0p_* | zp_*) ;;
        *) mv -f -- "$POSTINSTALL/$s" "$POSTINSTALL/$s.done" ;;
      esac
    else
      rc=1
    fi
  done
  return $rc
}

function run-preremove {
  local s
  [[ -v noscripts ]] && return 0
  for s in "$PREREMOVE/$1".{sh,dash,bat,cmd}
  do
    [[ -f $s ]] || continue
    run-script "$s" || return 1
  done
  return 0
}

function filter-shared-paths {
  local package=$1 list=$2 other
  local owners=$TMPD/other-owners
  : > "$owners"
  for other in "${!INST_FILE[@]}"
  do
    [[ $other == "$package" || ! -f $SETUP/$other.lst.gz ]] && continue
    gzip -cd -- "$SETUP/$other.lst.gz" >> "$owners" || return 1
  done
  gawk 'function normal(s) { sub(/^\.\//, "", s); sub(/^\//, "", s); return s }
  FILENAME == ARGV[1] { owned[normal($0)]=1; next }
  !(normal($0) in owned) { print }
  ' "$owners" "$list" > "$list.unshared" || return 1
  mv -f -- "$list.unshared" "$list"
}

function delete-paths {
  # delete-paths LISTFILE: remove the listed files, then emptied directories
  local e full dirs=()
  while IFS= read -r e
  do
    e=${e#./}
    e=${e#/}
    # never touch the root itself or anything escaping it
    [[ -z $e || $e == . || /$e/ == */../* ]] && continue
    full=$ROOT/$e
    if [[ $e == */ ]]
    then
      dirs+=("${full%/}")
    elif [[ -L $full || -f $full ]]
    then
      rm -f -- "$full" || return 1
    elif [[ -d $full ]]
    then
      dirs+=("$full")
    fi
  done < "$1"
  # deepest first, so a parent is already empty when its turn comes
  (( ${#dirs[@]} )) && printf '%s\n' "${dirs[@]}" |
    gawk -F/ '{ print NF "\t" $0 }' | LC_ALL=C sort -t$'\t' -k1,1nr | cut -f2- |
    while IFS= read -r e
    do
      rmdir -- "$e" 2>/dev/null
    done
  return 0
}

function install-archive {
  # install-archive PKG ARCHIVE FLAG: unpack, record manifest and database;
  # FLAG is 1 (manual), 0 (dependency) or keep
  local p=$1 arc=$2 flag=$3 man=$SETUP/$1.lst.gz rc=0
  local new=$TMPD/$1.new old=$TMPD/$1.old
  mkdir -p -- "$SETUP"
  if is-installed "$p" && [[ -f $man ]]
  then
    gzip -cd -- "$man" > "$old"
    run-preremove "$p" || return 1
  fi
  # one pass both unpacks and yields the file list (the old code read twice)
  tar -x -v --quoting-style=literal -f "$arc" -C "$ROOT/" > "$new" || rc=1
  if (( rc ))
  then
    warn "extraction of ${arc##*/} was incomplete; database and old manifest retained, retry reinstall"
    return 1
  fi
  gzip -c "$new" > "$man.tmp.$$" && mv -f -- "$man.tmp.$$" "$man" || return 1
  # an upgrade drops files the new version no longer ships
  if [[ -f $old ]]
  then
    LC_ALL=C comm -23 <(LC_ALL=C sort -u "$old") <(LC_ALL=C sort -u "$new") > "$old.stale"
    filter-shared-paths "$p" "$old.stale" || return 1
    delete-paths "$old.stale" || return 1
  fi
  INST_FILE[$p]=${arc##*/}
  case $flag in
    keep) INST_FLAG[$p]=${INST_FLAG[$p]:-0} ;;
       *) INST_FLAG[$p]=$flag ;;
  esac
  save-db || return 1
  printf '%s\n%s\n' "${INST_FILE[$p]}" "${IDX_DEPS[$p]}" > "$SETUP/$p.deps.tmp.$$" || return 1
  mv -f -- "$SETUP/$p.deps.tmp.$$" "$SETUP/$p.deps" || return 1
  INST_DEPS[$p]=${IDX_DEPS[$p]}
  INST_KNOWN[$p]=1
  return $rc
}

function remove-package {
  local p=$1 man=$SETUP/$1.lst.gz
  if [[ -f $man ]]
  then
    run-preremove "$p" || return 1
    gzip -cd -- "$man" > "$TMPD/$p.rm" || return 1
    filter-shared-paths "$p" "$TMPD/$p.rm" || return 1
    delete-paths "$TMPD/$p.rm" || return 1
  else
    warn "manifest of $p is missing; use reinstall to repair before removal"
    return 1
  fi
  rm -f -- "$man" "$POSTINSTALL/$p".{sh,dash,bat,cmd}.done
  rm -f -- "$SETUP/$p.deps"
  unset 'INST_FILE[$p]' 'INST_FLAG[$p]'
  save-db || return 1
  log-action "remove $p"
  echo "Package $p removed"
  return 0
}

# ---------------------------------------------------------------------------
# planning and execution

function fetch-package {
  # fetch-package PKG: download into the cache and verify; path in REPLY
  local p=$1 path=${IDX_FILE[$1]} hash=${IDX_HASH[$1]} dest
  dest=$cachedir/$path
  mkdir -p -- "${dest%/*}" || return 1
  if [[ -f $dest ]] && verify-hash "$dest" "$hash"
  then
    echo "Found ${path##*/} in cache"
  else
    echo "Downloading ${path##*/}"
    fetch "$mirrorurl/$path" "$dest" || { warn "download failed: $p"; return 1; }
    if ! verify-hash "$dest" "$hash"
    then
      warn "checksum mismatch: ${path##*/}"
      rm -f -- "$dest"
      return 1
    fi
  fi
  REPLY=$dest
}

function plan-visit {
  local p=$1 d deps
  [[ ${PLAN_SEEN[$p]} ]] && return 0
  PLAN_SEEN[$p]=1
  if ! in-index "$p"
  then
    is-installed "$p" || { warn "dependency $p not found in setup.ini"; return 1; }
    return 0
  fi
  if [[ ! -v nodeps ]]
  then
    validate-dependencies "$p" || return 1
    deps=${IDX_DEPS[$p]}
    if is-installed "$p" && [[ ! ${UPG_SET[$p]} && ! ${REINST_SET[$p]} ]]
    then
      [[ ${INST_KNOWN[$p]} ]] || { warn "installed dependency metadata unavailable for $p; use Cygwin Setup"; return 1; }
      deps=${INST_DEPS[$p]}
    fi
    for d in $deps
    do
      plan-visit "$d" || return 1
    done
  fi
  if ! is-installed "$p"
  then
    PLAN+=("$p"); PLAN_ACT[$p]=install
  elif [[ ${UPG_SET[$p]} ]]
  then
    PLAN+=("$p"); PLAN_ACT[$p]=upgrade
  elif [[ ${REINST_SET[$p]} ]]
  then
    PLAN+=("$p"); PLAN_ACT[$p]=reinstall
  fi
}

function show-plan {
  local p new=() upg=() rei=()
  for p in "${PLAN[@]}"
  do
    case ${PLAN_ACT[$p]} in
      install) new+=("$p") ;;
      upgrade)
        upg+=("$p ($(file-version "$p" "${INST_FILE[$p]}") -> $(file-version "$p" "${PLAN_ARCHIVE[$p]:-${IDX_FILE[$p]}}"))") ;;
      reinstall) rei+=("$p") ;;
    esac
  done
  if (( ${#new[@]} ))
  then
    echo 'The following NEW packages will be installed:'
    printf '  %s\n' "${new[@]}"
  fi
  if (( ${#upg[@]} ))
  then
    echo 'The following packages will be upgraded:'
    printf '  %s\n' "${upg[@]}"
  fi
  if (( ${#rei[@]} ))
  then
    echo 'The following packages will be reinstalled:'
    printf '  %s\n' "${rei[@]}"
  fi
  echo "${#new[@]} to install, ${#upg[@]} to upgrade, ${#rei[@]} to reinstall."
}

function execute-plan {
  local p rc=0 failed=() flag verb
  # download everything first: a failed download aborts before any change
  for p in "${PLAN[@]}"
  do
    [[ ${PLAN_ARCHIVE[$p]} ]] && continue
    if fetch-package "$p"
    then
      PLAN_ARCHIVE[$p]=$REPLY
    else
      failed+=("$p")
    fi
  done
  if (( ${#failed[@]} ))
  then
    warn "could not download: ${failed[*]}; nothing was changed"
    return 1
  fi
  for p in "${PLAN[@]}"
  do
    case ${PLAN_ACT[$p]} in
      install)   verb=Installing;   flag=${PLAN_FLAG[$p]:-0} ;;
      upgrade)   verb=Upgrading;    flag=keep ;;
      reinstall) verb=Reinstalling; flag=keep ;;
    esac
    echo "$verb $p"
    if install-archive "$p" "${PLAN_ARCHIVE[$p]}" "$flag"
    then
      log-action "${PLAN_ACT[$p]} $p ${INST_FILE[$p]}"
      case ${PLAN_ACT[$p]} in
        install)   echo "Package $p installed"   ;;
        upgrade)   echo "Package $p upgraded"    ;;
        reinstall) echo "Package $p reinstalled" ;;
      esac
    else
      warn "installation failed for $p; remaining packages were not extracted"
      return 1
    fi
  done
  run-postinstall || { warn 'some postinstall scripts failed'; rc=1; }
  (( ${#failed[@]} )) && warn "failed: ${failed[*]}"
  return $rc
}

function run-plan {
  # Shared execution for install, upgrade, and reinstall.
  if (( ! ${#PLAN[@]} ))
  then
    [[ -v simulate ]] && { echo 'No package changes planned.'; return 0; }
    run-postinstall
    return $?
  fi
  show-plan
  if [[ -v simulate ]]
  then
    echo 'Simulation only, nothing was changed.'
    return 0
  fi
  confirm || { echo Aborted.; return 1; }
  execute-plan
}

function guard-running-cygwin {
  # replacing cygwin1.dll from inside a running cygwin fails or corrupts it
  if [[ -z $ROOT && $(uname -s) == CYGWIN* ]] && [[ ${1} == cygwin ]]
  then
    warn 'skipping cygwin: cygwin1.dll is in use, update it with setup.exe'
    return 1
  fi
  return 0
}

# ---------------------------------------------------------------------------
# operations

function apt-update {
  # do not auto-fetch inside find-workspace, we fetch exactly once here
  no_auto_setup=1 find-workspace
  get-setup
}

function apt-install {
  check-packages || return 1
  find-workspace
  load-index
  load-db
  local p
  for p in "${pks[@]}"
  do
    if ! in-index "$p" && ! is-installed "$p"
    then
      warn "Unable to locate package $p"
      return 1
    fi
    PLAN_FLAG[$p]=1
    plan-visit "$p" || return 1
  done
  run-plan || return 1
  if [[ ! -v simulate ]]
  then
    for p in "${pks[@]}"; do INST_FLAG[$p]=1; done
    save-db
  fi
}



function apt-reinstall {
  check-packages || return 1
  find-workspace
  load-index
  load-db
  local p
  for p in "${pks[@]}"
  do
    is-installed "$p" || { warn "Package $p is not installed, use install"; return 1; }
    guard-running-cygwin "$p" || return 1
    select-installed-version "$p" || return 1
    REINST_SET[$p]=1
  done
  for p in "${pks[@]}"
  do
    plan-visit "$p" || return 1
  done
  run-plan
}

function apt-upgrade {
  find-workspace
  load-index
  load-db
  local p targets=() bad=0
  if (( ${#pks[@]} ))
  then
    for p in "${pks[@]}"
    do
      if ! is-installed "$p"
      then
        warn "Package $p is not installed"
        bad=1
      elif is-upgradable "$p"
      then
        targets+=("$p")
      else
        echo "$p is already the newest version"
      fi
    done
  else
    while read -r p
    do
      is-upgradable "$p" && targets+=("$p")
    done < <(sorted-installed)
  fi
  for p in "${targets[@]}"
  do
    guard-running-cygwin "$p" || return 1
    UPG_SET[$p]=1
  done
  for p in "${!UPG_SET[@]}"
  do
    plan-visit "$p" || return 1
  done
  if (( ! ${#PLAN[@]} ))
  then
    echo 'All packages are up to date.'
    return $bad
  fi
  run-plan || return 1
  return $bad
}

function apt-remove {
  check-packages || return 1
  find-workspace
  load-index
  load-db
  local p q d idx=1 bad=0 targets=() dependents
  for p in "${pks[@]}"
  do
    if ! is-installed "$p"
    then
      echo "Package $p is not installed, skipping"
      continue
    fi
    if is-essential "$p"
    then
      warn "apt-cyg cannot remove essential package $p"
      bad=1
      continue
    fi
    targets+=("$p")
  done
  for q in "${!INST_FILE[@]}"
  do
    if [[ ! ${INST_KNOWN[$q]} && ! -v force ]]
    then
      warn "installed dependency metadata unavailable for $q; use Cygwin Setup"
      return 1
    fi
  done
  # refuse to break installed packages that still depend on a target
  if (( idx ))
  then
    for p in "${targets[@]}"
    do
      dependents=
      while read -r q
      do
        in-list "$q" "${targets[*]}" && continue
        for d in ${INST_DEPS[$q]}
        do
          [[ $d == "$p" ]] && dependents+=" $q"
        done
      done < <(sorted-installed)
      if [[ $dependents ]]
      then
        if [[ -v force ]]
        then
          warn "removing $p anyway (--force), needed by:$dependents"
        else
          warn "cannot remove $p, needed by:$dependents (use --force)"
          bad=1
        fi
      fi
    done
  else
    warn 'no setup.ini available, reverse dependencies not checked'
  fi
  (( bad )) && return 1
  (( ${#targets[@]} )) || return 0
  echo 'The following packages will be REMOVED:'
  printf '  %s\n' "${targets[@]}"
  if [[ -v simulate ]]
  then
    echo 'Simulation only, nothing was changed.'
    return 0
  fi
  confirm || { echo Aborted.; return 1; }
  for p in "${targets[@]}"
  do
    remove-package "$p" || return 1
  done
}

function apt-autoremove {
  find-workspace
  load-index
  load-db
  local p d orphans=()
  declare -A keep
  local -a stack
  # Roots: manual picks, Base category, essentials, and unavailable packages.
  for p in "${!INST_FILE[@]}"
  do
    if [[ ${INST_FLAG[$p]} == 1 ]] || in-list Base "${IDX_CAT[$p]}" ||
       in-list "$p" "$ESSENTIAL_PKGS" || ! in-index "$p"
    then
      stack+=("$p")
    fi
  done
  for p in "${!INST_FILE[@]}"
  do
    [[ ${INST_KNOWN[$p]} ]] || { warn "installed dependency metadata unavailable for $p; refusing autoremove"; return 1; }
  done
  # mark everything reachable through dependencies
  while (( ${#stack[@]} ))
  do
    p=${stack[-1]}
    unset 'stack[-1]'
    [[ ${keep[$p]} ]] && continue
    keep[$p]=1
    for d in ${INST_DEPS[$p]}
    do
      is-installed "$d" && [[ ! ${keep[$d]} ]] && stack+=("$d")
    done
  done
  while read -r p
  do
    [[ ${keep[$p]} ]] || orphans+=("$p")
  done < <(sorted-installed)
  if (( ! ${#orphans[@]} ))
  then
    echo 'Nothing to autoremove.'
    return 0
  fi
  echo 'The following packages are no longer required and will be REMOVED:'
  printf '  %s\n' "${orphans[@]}"
  if [[ -v simulate ]]
  then
    echo 'Simulation only, nothing was changed.'
    return 0
  fi
  confirm || { echo Aborted.; return 1; }
  for p in "${orphans[@]}"
  do
    remove-package "$p" || return 1
  done
}



function apt-download {
  check-packages || return 1
  find-workspace
  load-index
  local p rc=0
  for p in "${pks[@]}"
  do
    if ! in-index "$p"
    then
      warn "Unable to locate package $p"
      rc=1
      continue
    fi
    # cache only: no manifest is written for a package that is not installed
    fetch-package "$p" && echo "$REPLY" || rc=1
  done
  return $rc
}

function apt-show {
  check-packages || return 1
  find-workspace
  load-db
  local p names= inst=
  for p in "${pks[@]}"
  do
    names+=$p$'\n'
    is-installed "$p" && inst+="$p ${INST_FILE[$p]}"$'\n'
  done
  # one pass over setup.ini for all names; a record is one package stanza
  names=$names inst=$inst gawk '
  BEGIN {
    n = split(ENVIRON["names"], want, "\n") - 1
    m = split(ENVIRON["inst"], a, "\n")
    for (i = 1; i <= m; i++) if (split(a[i], kv, " ") == 2) inst[kv[1]] = kv[2]
    for (i = 1; i <= n; i++) idx[want[i]] = i
  }
  $1 in idx { rec[$1] = $0 }
  END {
    for (i = 1; i <= n; i++) {
      p = want[i]
      if (i > 1) print ""
      if (p in rec) {
        r = rec[p]
        sub(/\n+$/, "", r)
        print "@ " r
        print "installed: " (p in inst ? inst[p] : "no")
      } else {
        print "Unable to locate package " p
        miss = 1
      }
    }
    exit miss
  }
  ' RS='\n\n@ ' FS='\n' "$archdir/setup.ini"
}

DEP_AWK='
BEGIN { FS = "|" }
NR > 1 {
  n = split($6, a, " ")
  for (i = 1; i <= n; i++) {
    if (ENVIRON["reverse"]) {
      cnt[a[i]]++
      reqs[a[i]][cnt[a[i]]] = $1
    } else {
      reqs[$1][i] = a[i]
    }
  }
}
END { prpg(ENVIRON["pkg"]) }
function join(arr, from, to, sep,    out, i) {
  out = arr[from]
  for (i = from + 1; i <= to; i++) out = out sep arr[i]
  return out
}
# the path stack doubles as cycle detection: never revisit a node on the path
function onpath(small,    i) {
  for (i = 1; i <= depth; i++) if (spath[i] == small) return 1
  return 0
}
function prpg(fpg,    each) {
  if (onpath(fpg)) return
  spath[++depth] = fpg
  print join(spath, 1, depth, ENVIRON["sep"])
  if (fpg in reqs)
    for (each in reqs[fpg])
      prpg(reqs[fpg][each])
  delete spath[depth--]
}
'

function apt-depends {
  check-packages || return 1
  find-workspace
  load-index
  local p rc=0
  for p in "${pks[@]}"
  do
    in-index "$p" || { warn "Unable to locate package $p"; rc=1; continue; }
    pkg=$p sep=' > ' reverse= gawk "$DEP_AWK" "$archdir/setup.idx"
  done
  return $rc
}

function apt-rdepends {
  check-packages || return 1
  find-workspace
  load-index
  local p
  for p in "${pks[@]}"
  do
    pkg=$p sep=' < ' reverse=1 gawk "$DEP_AWK" "$archdir/setup.idx"
  done
}

function apt-list {
  load-db
  local pkg sbq names=()
  mapfile -t names < <(sorted-installed)
  (( ${#names[@]} )) || return 0
  for pkg in "${pks[@]}"
  do
    # a blank line between groups: let fails while sbq is still 0
    let sbq++ && echo
    printf '%s\n' "${names[@]}" | pat=$pkg fold=${ignore_case:-0} gawk 'BEGIN { IGNORECASE=ENVIRON["fold"] } $0 ~ ENVIRON["pat"]'
  done
  let sbq && return 0
  printf '%s\n' "${names[@]}"
}

function apt-listall {
  check-packages || return 1
  find-workspace
  build-index || return 1
  local pkg sbq
  for pkg in "${pks[@]}"
  do
    let sbq++ && echo
    pat=$pkg fold=${ignore_case:-0} gawk -F'|' 'BEGIN { IGNORECASE=ENVIRON["fold"] } NR > 1 && $1 ~ ENVIRON["pat"] { print $1 }' "$archdir/setup.idx"
  done
}

function apt-category {
  check-packages || return 1
  find-workspace
  build-index || return 1
  local cat sbq
  for cat in "${pks[@]}"
  do
    let sbq++ && echo
    # whole word, case-insensitive: "Libs" must not match "Perl-Libs"
    cat=$cat gawk -F'|' '
    NR > 1 {
      n = split($7, a, " ")
      for (i = 1; i <= n; i++)
        if (tolower(a[i]) == tolower(ENVIRON["cat"])) { print $1; break }
    }
    ' "$archdir/setup.idx"
  done
}

function apt-listfiles {
  check-packages || return 1
  load-db
  local pkg sbq rc=0
  for pkg in "${pks[@]}"
  do
    (( sbq++ )) && echo
    if is-installed "$pkg" && [[ -f $SETUP/$pkg.lst.gz ]]
    then
      gzip -cd -- "$SETUP/$pkg.lst.gz"
      continue
    fi
    # not installed: list the archive itself, write nothing under /etc/setup
    find-workspace
    load-index
    if in-index "$pkg" && fetch-package "$pkg" >/dev/null
    then
      tar -tf "$REPLY"
    else
      warn "Unable to list files of $pkg"
      rc=1
    fi
  done
  return $rc
}

function apt-search {
  check-packages || return 1
  load-db
  local pkg key keys= p
  for pkg in "${pks[@]}"
  do
    key=
    # a bare command name resolves through PATH (live system only)
    [[ -z $ROOT && $pkg != */* ]] && key=$(type -P -- "$pkg")
    [[ $key ]] || key=$pkg
    keys+=$key$'\n'
  done
  echo 'Searching installed packages...'
  # one stream of all manifests, each prefixed by a \001 owner marker
  for p in $(sorted-installed)
  do
    [[ -f $SETUP/$p.lst.gz ]] || continue
    printf '\001%s\n' "$p"
    gzip -cd -- "$SETUP/$p.lst.gz"
  done | keys=$keys gawk '
  function norm(s) {
    sub(/^\.?\//, "", s)
    # /bin and /lib are mounts of /usr/bin and /usr/lib on cygwin
    if (s ~ /^(bin|lib)\//) s = "usr/" s
    return s
  }
  BEGIN {
    n = split(ENVIRON["keys"], k, "\n") - 1
    for (i = 1; i <= n; i++) {
      isp[i] = (k[i] ~ /\//)
      if (isp[i]) k[i] = norm(k[i])
    }
  }
  /^\001/ { pkg = substr($0, 2); next }
  {
    line = norm($0)
    b = line
    sub(/.*\//, "", b)
    for (i = 1; i <= n; i++) {
      hit = isp[i] ? (line == k[i] || line == k[i] ".exe") : (b == k[i] || b == k[i] ".exe")
      if (hit && ! ((i, pkg) in seen)) {
        seen[i, pkg]
        out[i] = out[i] pkg "\n"
      }
    }
  }
  END {
    for (i = 1; i <= n; i++) printf "%s", out[i]
  }
  '
}

function apt-searchall {
  check-packages || return 1
  local pkg qs matches=$TMPD/matches
  for pkg in "${pks[@]}"
  do
    qs="text=1&arch=$arch&grep=$(urlencode "$pkg")"
    # small text answer: ask for a gzip transfer
    fetch "https://cygwin.com/cgi-bin2/package-grep.cgi?$qs" "$matches" text ||
      { warn "searchall: request failed for $pkg"; return 1; }
    gawk '
    NR == 1 {next}
    mc[$1]++ {next}
    /-debuginfo-/ {next}
    /^cygwin32-/ {next}
    {print $1}
    ' FS=-[[:digit:]] "$matches"
  done
}

function apt-mirror {
  if (( ${#pks[@]} ))
  then
    rc-set last-mirror "${pks[0]}" || die "cannot write $RC"
    echo "Mirror set to ${pks[0]}."
  else
    rc-get last-mirror
  fi
}

function apt-cache {
  local vas
  if (( ${#pks[@]} ))
  then
    # setup.exe expects a windows path in setup.rc
    if command -v cygpath >/dev/null
    then
      vas=$(cygpath -aw "${pks[0]}")
    else
      vas=$(realpath -m -- "${pks[0]}")
    fi
    rc-set last-cache "$vas" || die "cannot write $RC"
    echo "Cache set to $vas."
  else
    rc-get last-cache
  fi
}

function apt-mark-manual {
  check-packages || return 1
  load-db
  local p
  for p in "${pks[@]}"
  do
    is-installed "$p" || { warn "$p is not installed"; return 1; }
  done
  for p in "${pks[@]}"
  do
    echo "Mark $p as ${command#mark-}"
    [[ $command == mark-manual ]] && INST_FLAG[$p]=1 || INST_FLAG[$p]=0
  done
  [[ -v simulate ]] || save-db
}

function apt-mark-auto {
  apt-mark-manual
}

function apt-list-manual {
  load-db
  local p flag=1
  [[ $command == list-auto ]] && flag=0
  while IFS= read -r p
  do
    [[ ${INST_FLAG[$p]} == "$flag" ]] && printf '%s\n' "$p"
  done < <(sorted-installed)
  return 0
}

function apt-list-auto {
  apt-list-manual
}

function apt-key-add {
  check-packages || return 1
  command -v gpg >/dev/null || die 'gnupg is required'
  local key
  for key in "${pks[@]}"
  do
    [[ -f $key ]] || { warn "key file not found: $key"; return 1; }
  done
  [[ ! -f $KEYRING ]] || gpg --batch --homedir "$TMPD/gpg" --import "$KEYRING" >/dev/null 2>&1 || return 1
  for key in "${pks[@]}"
  do
    gpg --batch --homedir "$TMPD/gpg" --import "$key" || return 1
  done
  gpg --batch --homedir "$TMPD/gpg" --export > "$KEYRING.tmp.$$" || return 1
  [[ -s $KEYRING.tmp.$$ ]] || return 1
  mv -f -- "$KEYRING.tmp.$$" "$KEYRING"
}

function apt-key-list {
  command -v gpg >/dev/null || die 'gnupg is required'
  [[ -s $KEYRING ]] || { warn "no trusted keyring at $KEYRING"; return 1; }
  gpg --batch --homedir "$TMPD/gpg" --no-default-keyring --keyring "$KEYRING" --list-keys --fingerprint
}

function apt-mirrors-list {
  [[ -f $RC ]] || return 1
  gawk '
  $0 == "mirrors-lst" { active=1; next }
  active && /^\t/ { sub(/^\t/, ""); split($0, entry, ";"); print entry[1]; next }
  active { exit }
  ' "$RC"
}

function apt-benchmark-mirrors {
  local url started finished elapsed bytes output=$TMPD/benchmark
  local results=$TMPD/benchmark-results
  local -a candidates=("${pks[@]}")
  if (( ! ${#candidates[@]} ))
  then
    url=$(rc-get last-mirror) || return 1
    candidates=("$url")
  fi
  printf 'seconds\tbytes\tmirror\n'
  for url in "${candidates[@]}"
  do
    started=$(date +%s%N)
    if APT_CYG_TIMEOUT=${APT_CYG_BENCHMARK_TIMEOUT:-10} fetch "${url%/}/$arch/setup.xz" "$output" 2>/dev/null
    then
      finished=$(date +%s%N)
      elapsed=$(gawk -v start="$started" -v end="$finished" 'BEGIN { printf "%.3f", (end-start)/1000000000 }')
      bytes=$(wc -c < "$output")
      printf '%s\t%s\t%s\n' "$elapsed" "$bytes" "$url" >> "$results"
    else
      printf 'FAILED\t0\t%s\n' "$url" >&2
    fi
  done
  [[ -f $results ]] || return 1
  LC_ALL=C sort -n -k1,1 "$results"
}

function apt-self-update {
  if [[ -v simulate ]]
  then
    printf 'Would replace %s from %s (backup at %s.bak)\n' "$SELF" "$SELF_UPDATE_URL" "$SELF"
    return 0
  fi
  local candidate=$TMPD/apt-cyg.new mode
  fetch "$SELF_UPDATE_URL" "$candidate" || return 1
  head -n 1 "$candidate" | grep -qx '#!/bin/bash' || { warn 'invalid update script'; return 1; }
  bash -n "$candidate" || return 1
  mode=$(stat -c %a -- "$SELF") || return 1
  cp -p -- "$SELF" "$SELF.bak" || return 1
  cp -- "$candidate" "$SELF.new.$$" || return 1
  chmod "$mode" "$SELF.new.$$" || return 1
  mv -f -- "$SELF.new.$$" "$SELF" || return 1
  echo "Updated $SELF; previous version saved at $SELF.bak"
}

function apt-upgrade-self {
  apt-self-update
}

function apt-completion {
  cat <<'COMPLETION'
# Bash completion for apt-cyg. Source this file from Bash.
_apt_cyg_complete() {
  local word=${COMP_WORDS[COMP_CWORD]} operation= item
  local commands='check localinstall setup update-setup dist-upgrade show-packages-busyness busy source mirror-source key-del key-finger pathof stats packages-total-count packages-total-size packages-cached-count packages-cached-size describe find ls-categories scriptinfo mirrors-list-online mirrors-list-long benchmark-parallel-mirrors benchmark-parallel-mirrors-list install upgrade reinstall remove autoremove update download show depends rdepends list listall category listfiles search searchall mirror cache mark-auto mark-manual list-auto list-manual key-add key-list self-update upgrade-self benchmark-mirrors mirrors-list completion completion-install completion-uninstall'
  local options='--files --fix --allow-untrusted --ignore-case --quiet --verbose --no-progress --long --proxy --file --name --max-jobs --mirror --cache --simulate --dry-run --yes --nodeps --noscripts --no-verify --force --help --version'
  for item in "${COMP_WORDS[@]:1:COMP_CWORD-1}"
  do
    [[ $item == -* ]] || { operation=$item; break; }
  done
  if [[ $word == -* ]]
  then
    mapfile -t COMPREPLY < <(compgen -W "$options" -- "$word")
  elif [[ ! $operation ]]
  then
    mapfile -t COMPREPLY < <(compgen -W "$commands" -- "$word")
  else
    case $operation in
      remove|reinstall|mark-auto|mark-manual|busy|show-packages-busyness|check)
        mapfile -t COMPREPLY < <(compgen -W "$(apt-cyg list 2>/dev/null)" -- "$word") ;;
      install|upgrade|download|source|mirror-source|show|depends|rdepends)
        mapfile -t COMPREPLY < <(compgen -W "$(apt-cyg listall '.*' 2>/dev/null)" -- "$word") ;;
    esac
  fi
}
complete -F _apt_cyg_complete apt-cyg
COMPLETION
}

function apt-completion-install {
  local destination=$ROOT/etc/bash_completion.d/apt-cyg
  mkdir -p -- "${destination%/*}" || return 1
  apt-completion > "$destination.tmp.$$" || return 1
  mv -f -- "$destination.tmp.$$" "$destination" || return 1
  echo "Installed Bash completion at $destination"
}

function apt-completion-uninstall {
  rm -f -- "$ROOT/etc/bash_completion.d/apt-cyg"
}

# Additional operations integrated into the single-file installer.

function valid-name {
  [[ $1 =~ ^[A-Za-z0-9_+.-]+$ && $1 != . && $1 != .. ]]
}

function safe-relative-path {
  [[ $1 && $1 != /* && /$1/ != */../* && $1 != *$'\n'* && $1 != *\\* ]]
}

function validate-database {
  [[ -f $DB ]] || { warn "missing database: $DB"; return 1; }
  gawk '
  NR == 1 { if ($0 != "INSTALLED.DB 3") { print "invalid database header"; bad=1 }; next }
  NF != 3 || $1 !~ /^[A-Za-z0-9_+.-]+$/ || $1 == "." || $1 == ".." ||
    $2 !~ /^[^/\\]+\.tar\.[A-Za-z0-9]+$/ || $3 !~ /^[01]$/ {
    print "malformed database entry at line " NR; bad=1; next
  }
  seen[$1]++ { print "duplicate database entry: " $1; bad=1 }
  END { if (NR == 0) bad=1; exit bad }
  ' "$DB"
}

function check-scan {
  local p d entry script manifest bad
  CHECK_ERRORS=0 CHECK_BROKEN=() CHECK_MISSING=()
  for p in "${CHECK_TARGETS[@]}"
  do
    is-installed "$p" || { warn "$p is not installed"; (( CHECK_ERRORS++ )); continue; }
    bad=0
    manifest=$SETUP/$p.lst.gz
    if [[ ! -f $manifest ]] || ! gzip -cd -- "$manifest" > "$TMPD/check.manifest"
    then
      warn "$p: missing or unreadable manifest"
      bad=1
    elif [[ -v files ]]
    then
      while IFS= read -r entry
      do
        entry=${entry#./}; entry=${entry#/}
        [[ ! $entry || $entry == */ ]] && continue
        if ! safe-relative-path "$entry" || [[ ! -e $ROOT/$entry && ! -L $ROOT/$entry ]]
        then
          warn "$p: missing or invalid file: $entry"
          bad=1
        fi
      done < "$TMPD/check.manifest"
    fi
    if (( bad )); then CHECK_BROKEN+=("$p"); (( CHECK_ERRORS++ )); fi
    if [[ ! ${INST_KNOWN[$p]} ]]
    then
      warn "$p: installed-version dependency metadata unavailable"
      (( CHECK_ERRORS++ ))
      continue
    fi
    for d in ${INST_DEPS[$p]}
    do
      if ! is-installed "$d"
      then
        warn "$p: missing dependency $d"
        CHECK_MISSING+=("$d")
        (( CHECK_ERRORS++ ))
      fi
    done
  done
  for script in "$POSTINSTALL"/*.{sh,dash,bat,cmd}
  do
    [[ -f $script ]] || continue
    case ${script##*/} in 0p_*|zp_*) continue ;; esac
    warn "pending postinstall: ${script##*/}"
    (( CHECK_ERRORS++ ))
  done
  printf 'check: %s error(s)\n' "$CHECK_ERRORS"
  (( CHECK_ERRORS == 0 ))
}

function apt-check {
  validate-database || { warn 'database requires manual repair; no automatic changes made'; return 1; }
  find-workspace
  load-index
  load-db
  local p
  CHECK_TARGETS=("${pks[@]}")
  (( ${#CHECK_TARGETS[@]} )) || mapfile -t CHECK_TARGETS < <(sorted-installed)
  check-scan && return 0
  [[ -v fix ]] || return 1
  for p in "${CHECK_TARGETS[@]}"
  do
    is-installed "$p" && [[ ${INST_KNOWN[$p]} ]] || { warn "cannot repair dependency records for $p automatically; use Setup"; return 1; }
    # Repair must not silently discard constraints on an existing Setup package.
    if [[ ! -f $SETUP/$p.deps ]] || [[ $(head -n 1 "$SETUP/$p.deps") != "${INST_FILE[$p]}" ]]
    then
      select-installed-version "$p" || return 1
      validate-dependencies "$p" || return 1
    fi
  done
  for p in "${CHECK_BROKEN[@]}"
  do
    guard-running-cygwin "$p" || return 1
    select-installed-version "$p" || return 1
    REINST_SET[$p]=1
  done
  for p in "${CHECK_BROKEN[@]}" "${CHECK_MISSING[@]}"
  do
    plan-visit "$p" || return 1
  done
  run-plan || return 1
  [[ -v simulate ]] && { echo 'Would recheck repaired packages and retry pending scripts.'; return 0; }
  check-scan
}

function apt-localinstall {
  check-packages || return 1
  [[ ! $pkgname || ${#pks[@]} == 1 ]] || die '--name requires exactly one archive'
  find-workspace
  load-index
  load-db
  local input archive base name record n f sz hash ver deps cats relation sf ss sh hint raw
  local -a names=()
  declare -A local_seen
  for input in "${pks[@]}"
  do
    [[ -f $input ]] || { warn "archive not found: $input"; return 1; }
    base=${input##*/}
    [[ $base =~ ^[A-Za-z0-9_+.:~.-]+\.tar\.[A-Za-z0-9]+$ ]] || { warn "invalid archive filename: $base"; return 1; }
    if [[ $pkgname ]]; then name=$pkgname
    elif [[ $base =~ ^(.+)-[^-]+-[^-]+\.tar\.[[:alnum:]]+$ ]]; then name=${BASH_REMATCH[1]}
    else warn "cannot determine package name: $base; use --name"; return 1; fi
    valid-name "$name" || die "invalid package name: $name"
    [[ ! ${local_seen[$name]} ]] || die "multiple local archives supplied for $name"
    local_seen[$name]=1
    guard-running-cygwin "$name" || return 1
    archive=$TMPD/local-${#names[@]}-$base
    cp -- "$input" "$archive" || return 1
    tar -tf "$archive" > "$TMPD/local.files" || return 1
    while IFS= read -r f
    do
      f=${f#./}
      [[ $f == ./ || $f == . ]] && continue
      safe-relative-path "$f" || { warn "unsafe archive member: $f"; return 1; }
    done < "$TMPD/local.files"
    record=$(wanted_package="$name" wanted_archive="$base" gawk "$IDX_AWK" "$archdir/setup.ini" | tail -n +2)
    if [[ $record ]]
    then
      IFS='|' read -r n f sz hash ver deps cats relation sf ss sh <<< "$record"
      verify-hash "$archive" "$hash" || { warn "local archive does not match authenticated metadata: $base"; return 1; }
    else
      [[ -v allow_untrusted ]] || { warn "$base is not in authenticated metadata; use --allow-untrusted only for a trusted local package"; return 1; }
      hint=${input%.tar.*}.hint
      [[ -f $hint ]] || { warn "local package requires dependency metadata: $hint"; return 1; }
      raw=$(gawk '
        $1 == "requires:" { req=substr($0,index($0,":")+1); seen=1 }
        $1 == "depends:" { dep=substr($0,index($0,":")+1); modern=1; seen=1 }
        $1 == "depends2:" { dep2=substr($0,index($0,":")+1); newest=1; seen=1 }
        END { if (!seen) exit 1; print newest ? dep2 : modern ? dep : req }
      ' "$hint") || { warn 'hint must explicitly declare dependencies, even an empty list'; return 1; }
      [[ $raw != *'|'* && $raw != *'('* && $raw != *')'* ]] || { warn 'version constraints and alternatives require Cygwin Setup'; return 1; }
      relation=$raw
      deps=${raw//,/ }
      warn "explicitly trusting local archive: $base"
    fi
    IDX_FILE[$name]=$base IDX_DEPS[$name]=$deps IDX_REL[$name]=${relation//%7C/|}
    validate-dependencies "$name" || return 1
    # Keep the original basename: installed.db must never record our temporary prefix.
    mkdir -p -- "$TMPD/local-${#names[@]}" || return 1
    mv -- "$archive" "$TMPD/local-${#names[@]}/$base" || return 1
    PLAN_ARCHIVE[$name]=$TMPD/local-${#names[@]}/$base
    PLAN_FLAG[$name]=1
    is-installed "$name" && UPG_SET[$name]=1
    names+=("$name")
  done
  for name in "${names[@]}"; do plan-visit "$name" || return 1; done
  run-plan || return 1
  if [[ ! -v simulate ]]
  then
    for name in "${names[@]}"; do INST_FLAG[$name]=1; done
    save-db
  fi
}

function apt-key-del {
  check-packages || return 1
  [[ -s $KEYRING ]] || die 'trusted keyring is missing'
  local fingerprint primaries
  gpg --batch --homedir "$TMPD/gpg" --import "$KEYRING" >/dev/null 2>&1 || return 1
  primaries=$(gpg --batch --homedir "$TMPD/gpg" --with-colons --list-keys |
    gawk -F: '$1 == "pub" { primary=1; next } primary && $1 == "fpr" { print $10; primary=0 }') || return 1
  for fingerprint in "${pks[@]}"
  do
    [[ $fingerprint =~ ^([[:xdigit:]]{40}|[[:xdigit:]]{64})$ ]] || die 'key-del requires a full primary-key fingerprint'
    in-list "${fingerprint^^}" "$primaries" || die "primary-key fingerprint not found: $fingerprint"
    gpg --batch --yes --homedir "$TMPD/gpg" --delete-key "$fingerprint" || return 1
  done
  gpg --batch --homedir "$TMPD/gpg" --export > "$KEYRING.tmp.$$" || return 1
  mv -f -- "$KEYRING.tmp.$$" "$KEYRING"
}

function apt-key-finger { apt-key-list; }

function apt-source {
  check-packages || return 1
  find-workspace
  load-index
  local name relative destination hash
  for name in "${pks[@]}"
  do
    relative=${IDX_SOURCE[$name]} hash=${IDX_SOURCE_HASH[$name]}
    safe-relative-path "$relative" || { warn "no valid current source archive for $name"; return 1; }
    destination=$cachedir/$relative
    mkdir -p -- "${destination%/*}" || return 1
    if [[ ! -f $destination ]] || ! verify-hash "$destination" "$hash"
    then
      fetch "$mirrorurl/$relative" "$destination" || return 1
    fi
    verify-hash "$destination" "$hash" || { warn "source checksum mismatch: $name"; return 1; }
    printf '%s\n' "$destination"
  done
}

function apt-mirror-source { apt-source; }

function apt-mirrors-list-online {
  fetch https://cygwin.com/mirrors.lst "$TMPD/mirrors.lst" || return 1
  if [[ -v long_listing ]]; then cat -- "$TMPD/mirrors.lst"
  else gawk -F';' '$1 ~ /^(https?|ftp):\/\// { print $1 }' "$TMPD/mirrors.lst"; fi
}

function apt-mirrors-list-long {
  [[ -f $RC ]] || return 1
  gawk '$0 == "mirrors-lst" { active=1; next }
    active && /^\t/ { sub(/^\t/, ""); print; next } active { exit }' "$RC"
}

function benchmark-one {
  local url=${1%/} id=$2 started finished elapsed output=$TMPD/benchmark.$2
  started=$(date +%s%N)
  if APT_CYG_TIMEOUT=${APT_CYG_BENCHMARK_TIMEOUT:-10} fetch "$url/$arch/setup.xz" "$output" 2>/dev/null
  then
    finished=$(date +%s%N)
    elapsed=$(gawk -v start="$started" -v end="$finished" 'BEGIN { printf "%.3f", (end-start)/1000000000 }')
    printf '%s\t%s\t%s\n' "$elapsed" "$(wc -c < "$output")" "$url" > "$TMPD/result.$id"
  else printf 'FAILED\t0\t%s\n' "$url" >&2; return 1; fi
}

function apt-benchmark-parallel-mirrors {
  local url pid i=0 failures=0
  local -a candidates=("${pks[@]}") pids=()
  if (( ! ${#candidates[@]} )); then mapfile -t candidates < <(apt-mirrors-list); fi
  (( ${#candidates[@]} )) || { warn 'no mirrors supplied or recorded'; return 1; }
  for url in "${candidates[@]}"
  do
    benchmark-one "$url" "$i" &
    pids+=("$!"); (( i++ ))
    if (( ${#pids[@]} >= max_jobs ))
    then
      for pid in "${pids[@]}"; do wait "$pid" || (( failures++ )); done
      pids=()
    fi
  done
  for pid in "${pids[@]}"; do wait "$pid" || (( failures++ )); done
  printf 'seconds\tbytes\tmirror\n'
  local -a results=("$TMPD"/result.*)
  [[ -f ${results[0]} ]] || return 1
  LC_ALL=C sort -n -k1,1 "${results[@]}"
  (( failures == 0 ))
}

function apt-benchmark-parallel-mirrors-list {
  pks=()
  apt-benchmark-parallel-mirrors
}

function apt-pathof {
  local item
  (( ${#pks[@]} )) || pks=(root cache mirror mirrordir setup.ini database keyring setup)
  no_auto_setup=1 find-workspace
  for item in "${pks[@]}"
  do
    case $item in
      root) printf '%s\n' "${ROOT:-/}" ;;
      cache) printf '%s\n' "$cache" ;;
      mirror) printf '%s\n' "$mirrorurl" ;;
      mirrordir|cache/mirrordir) printf '%s\n' "$cachedir" ;;
      setup.ini) printf '%s\n' "$archdir/setup.ini" ;;
      database) printf '%s\n' "$DB" ;;
      keyring) printf '%s\n' "$KEYRING" ;;
      setup) printf '%s\n' "$SETUP/setup-bin/setup-$arch.exe" ;;
      *) warn "unknown path: $item"; return 1 ;;
    esac
  done
}

function apt-stats {
  find-workspace
  load-index
  load-db
  local count size
  read -r count size < <(gawk -F'|' 'NR > 1 { n++; bytes+=$3 } END { printf "%d %.0f\n",n,bytes }' "$archdir/setup.idx")
  printf 'available-packages\t%s\navailable-archive-bytes\t%s\ninstalled-packages\t%s\n' "$count" "$size" "${#INST_FILE[@]}"
  read -r count size < <(find "$cachedir" -type f -name '*.tar.*' ! -name '*.part.*' -printf '%s\n' |
    gawk '{ n++; bytes+=$1 } END { printf "%d %.0f\n",n,bytes }')
  printf 'cached-archives\t%s\ncached-archive-bytes\t%s\n' "$count" "$size"
}

function apt-packages-total-count { apt-stats | gawk '$1 == "available-packages" { print $2 }'; }
function apt-packages-total-size { apt-stats | gawk '$1 == "available-archive-bytes" { print $2 }'; }
function apt-packages-cached-count { apt-stats | gawk '$1 == "cached-archives" { print $2 }'; }
function apt-packages-cached-size { apt-stats | gawk '$1 == "cached-archive-bytes" { print $2 }'; }

function apt-describe {
  check-packages || return 1
  find-workspace
  local pattern
  for pattern in "${pks[@]}"
  do
    pat=$pattern fold=${ignore_case:-0} gawk '
      function flush( text, p) {
        text=name " " desc " " longdesc; p=ENVIRON["pat"]
        if (ENVIRON["fold"] == 1) { text=tolower(text); p=tolower(p) }
        if (name != "" && text ~ p) print name " - " desc
      }
      /^@ / { flush(); name=$2; desc=longdesc=""; multiline=0; next }
      /^sdesc:/ { desc=substr($0,8); gsub(/^"|"$/, "", desc) }
      /^ldesc:/ { longdesc=substr($0,8); multiline=(gsub(/"/, "&") % 2); next }
      multiline { longdesc=longdesc " " $0; if (gsub(/"/, "&") % 2) multiline=0 }
      END { flush() }
    ' "$archdir/setup.ini" || return 1
  done
}

function apt-find { apt-listall; }

function apt-ls-categories {
  find-workspace
  build-index || return 1
  gawk -F'|' 'NR > 1 { n=split($7,a," "); for(i=1;i<=n;i++) if(a[i]!="") print a[i] }' "$archdir/setup.idx" | LC_ALL=C sort -u
}

function apt-scriptinfo {
  printf 'script\t%s\nroot\t%s\ndatabase\t%s\narchitecture\t%s\ndownloader\t%s\n' "$SELF" "${ROOT:-/}" "$DB" "$arch" "$(downloader)"
}

function apt-show-packages-busyness {
  check-packages || return 1
  load-db
  local package entry path maps process pid found readable=0
  local observed=$TMPD/in-use
  : > "$observed"
  # Observational only: never open package files for writing to test a lock.
  for maps in /proc/[0-9]*/maps
  do
    [[ -r $maps ]] || continue
    (( readable++ ))
    pid=${maps%/maps}; pid=${pid##*/}
    while IFS= read -r entry
    do
      [[ $entry == /* ]] || continue
      entry=${entry% (deleted)}
      path=$(readlink -f -- "$entry") || continue
      printf '%s\t%s\n' "$path" "$pid" >> "$observed"
    done < <(gawk '{ sub(/^[^ ]+ +[^ ]+ +[^ ]+ +[^ ]+ +[^ ]+ +/, ""); print }' "$maps" 2>/dev/null)
    process=/proc/$pid/exe
    path=$(readlink -f -- "$process" 2>/dev/null) && printf '%s\t%s\n' "$path" "$pid" >> "$observed"
  done
  for package in "${pks[@]}"
  do
    is-installed "$package" || { warn "$package is not installed"; return 1; }
    [[ -f $SETUP/$package.lst.gz ]] || { warn "manifest missing: $package"; return 1; }
    found=0
    gzip -cd -- "$SETUP/$package.lst.gz" > "$TMPD/busy.manifest" || return 1
    while IFS= read -r entry
    do
      entry=${entry#./}; entry=${entry#/}
      safe-relative-path "$entry" || continue
      path=$(readlink -f -- "$ROOT/$entry") || continue
      while IFS=$'\t' read -r process pid
      do
        if [[ $process == "$path" ]]; then printf 'busy\t%s\tpid=%s\t%s\n' "$package" "$pid" "$entry"; found=1; fi
      done < "$observed"
    done < "$TMPD/busy.manifest"
    if (( ! found )); then
      if (( readable )); then printf 'no-observed-use\t%s\n' "$package"
      else printf 'unknown\t%s\tprocess maps unavailable\n' "$package"; fi
    fi
  done
  warn 'Observations cover readable process maps only; Windows processes or locks may not be visible.'
}

function apt-busy { apt-show-packages-busyness; }

function setup-path { printf '%s\n' "$SETUP/setup-bin/setup-$arch.exe"; }

function verify-setup {
  # Official Setup always requires a signature, independently of --no-verify.
  local no_verify
  unset no_verify
  verify-signature "$1" "$2"
}

function apt-update-setup {
  local executable directory candidate=$TMPD/setup.exe
  executable=$(setup-path); directory=${executable%/*}
  [[ $arch == x86_64 || $arch == x86 ]] || die 'unsupported Setup architecture'
  if [[ -v simulate ]]; then printf 'Would download and verify https://cygwin.com/setup-%s.exe to %s\n' "$arch" "$executable"; return 0; fi
  fetch "https://cygwin.com/setup-$arch.exe" "$candidate" || return 1
  fetch "https://cygwin.com/setup-$arch.exe.sig" "$candidate.sig" || return 1
  verify-setup "$candidate" "$candidate.sig" || return 1
  [[ $(head -c 2 "$candidate") == MZ ]] || { warn 'Setup download is not a Windows executable'; return 1; }
  mkdir -p -- "$directory" || return 1
  cp -- "$candidate" "$executable.new.$$" && chmod 755 "$executable.new.$$" || return 1
  cp -- "$candidate.sig" "$executable.sig.new.$$" || return 1
  mv -f -- "$executable.sig.new.$$" "$executable.sig" && mv -f -- "$executable.new.$$" "$executable" || return 1
  printf 'Updated and verified %s\n' "$executable"
}

function apt-setup {
  local executable target argument
  for argument in "${pks[@]}"
  do
    case $argument in --r|--ro|--roo|--root|--r=*|--ro=*|--roo=*|--root=*|-R*|-[^-]*R*) die 'Setup root overrides are not allowed; the active Cygwin root is used' ;; esac
  done
  executable=$(setup-path)
  if [[ -v simulate ]]; then printf 'Would verify and launch %s for root %s with arguments:' "$executable" "${ROOT:-/}"; printf ' %q' "${pks[@]}"; echo; return 0; fi
  [[ $(uname -s) == CYGWIN* ]] && command -v cygpath >/dev/null || die 'Setup must be launched from native Cygwin'
  if [[ ! -f $executable ]]; then apt-update-setup || return 1; fi
  verify-setup "$executable" "$executable.sig" || return 1
  target=$(cygpath -aw "${ROOT:-/}") || return 1
  warn "Launching official Setup for $target; close other Cygwin applications before runtime updates."
  "$executable" "${pks[@]}" --root "$target" --wait
}

function apt-dist-upgrade {
  pks=(--upgrade-also "${pks[@]}")
  apt-setup
}

# ---------------------------------------------------------------------------
# process options

command=
max_jobs=4
package_files=()
until (( $# == 0 ))
do
  case $1 in
    --files) files=1 ;;
    --fix) fix=1 ;;
    --allow-untrusted) allow_untrusted=1 ;;
    --ignore-case|-i) ignore_case=1 ;;
    --quiet|-q) quiet=1 ;;
    --verbose|-v) verbose=1 ;;
    --no-progress) no_progress=1 ;;
    --long) long_listing=1 ;;
    --name|--proxy|--max-jobs|-j|--mirror|-m|--cache|-c|--file|-f)
      (( $# > 1 )) || die "missing value for $1"
      case $1 in
        --name) pkgname=$2 ;;
        --proxy) proxy_mode=$2 ;;
        --max-jobs|-j) max_jobs=$2 ;;
        --mirror|-m) mirror_override=$2 ;;
        --cache|-c) cache_override=$2 ;;
        --file|-f) package_files+=("$2") ;;
      esac
      shift ;;
    --name=*) pkgname=${1#*=} ;;
    --proxy=*) proxy_mode=${1#*=} ;;
    --max-jobs=*) max_jobs=${1#*=} ;;
    --nodeps)    nodeps=1    ;;
    --noscripts) noscripts=1 ;;
    --no-verify) no_verify=1 ;;
    --force)     force=1     ;;
    -y | --yes)  yes=1       ;;
    -s | --simulate | --dry-run) simulate=1 ;;
    --version)
      printf '%s' "$version"
      exit 0
    ;;
    -h | --help)
      printf '%s' "$usage"
      exit 0
    ;;
    --)
      shift
      pks+=("$@")
      break
    ;;
    -*)
      die "unknown option: $1"
    ;;
    *)
      # the first operation word is the command, everything else a target
      if [[ ! $command ]] && in-list "$1" "$COMMANDS"
      then
        command=$1
      else
        pks+=("$1")
      fi
    ;;
  esac
  shift
done

[[ $max_jobs =~ ^[1-9][0-9]?$ ]] && (( max_jobs <= 64 )) || die '--max-jobs must be between 1 and 64'
[[ ! $pkgname ]] || valid-name "$pkgname" || die 'invalid --name value'
if [[ -v fix || -v files ]]; then [[ $command == check ]] || die '--fix and --files are only valid with check'; fi
if [[ -v pkgname || -v allow_untrusted ]]; then [[ $command == localinstall ]] || die '--name and --allow-untrusted are only valid with localinstall'; fi
for package_file in "${package_files[@]}"
do
  [[ -r $package_file ]] || die "cannot read package list: $package_file"
  while IFS= read -r line || [[ $line ]]
  do
    line=${line%$'\r'}
    [[ ! $line || $line == \#* ]] || pks+=("$line")
  done < "$package_file"
done
case ${proxy_mode:-inherit} in
  inherit) ;;
  none) unset http_proxy https_proxy ftp_proxy all_proxy HTTP_PROXY HTTPS_PROXY FTP_PROXY ALL_PROXY ;;
  http://*|https://*|socks5://*|socks5h://*)
    export http_proxy=$proxy_mode https_proxy=$proxy_mode ftp_proxy=$proxy_mode all_proxy=$proxy_mode
    export HTTP_PROXY=$proxy_mode HTTPS_PROXY=$proxy_mode FTP_PROXY=$proxy_mode ALL_PROXY=$proxy_mode
    unset no_proxy NO_PROXY ;;
  *) die '--proxy accepts inherit, none, or an http/https/socks5 URL' ;;
esac
[[ ! -v quiet ]] || exec 1>/dev/null

# names on a pipe, e.g. cat list.txt | apt-cyg install
if [[ $command && ${#pks[@]} -eq 0 && -p /dev/stdin ]] && in-list "$command" "$TARGET_COMMANDS"
then
  while read -r line
  do
    [[ $line ]] && pks+=("$line")
  done
fi

if [[ $command ]] && type -t "apt-$command" | grep -q function
then
  command -v gawk >/dev/null || die 'gawk is required'
  readonly arch=${APT_CYG_ARCH:-${HOSTTYPE/i6/x}}
  TMPD=$(mktemp -d "${TMPDIR:-/tmp}/apt-cyg.XXXXXX") || die 'cannot create a temp directory'
  mkdir -m 700 -- "$TMPD/gpg" || die 'cannot create private GPG home'
  for package_name in "${pks[@]}"
  do
    case $command in
      install|upgrade|reinstall|remove|mark-auto|mark-manual|check|source|mirror-source|busy|show-packages-busyness)
        valid-name "$package_name" || die "invalid package name: $package_name" ;;
    esac
  done
  if { in-list "$command" "$MUTATING_COMMANDS" || [[ $command == check && -v fix ]]; } && [[ ! -v simulate ]]
  then
    acquire-lock
  fi
  if [[ -v simulate ]]
  then
    case $command in
      update|mirror|cache|key-add|key-del|completion-install|completion-uninstall)
        printf 'Would run %s %s; no configuration or package changes made.\n' "$command" "${pks[*]}"
        exit 0 ;;
    esac
  fi
  if [[ -v verbose ]]
  then
    printf 'Command: %s; root: %s; database: %s\n' "$command" "${ROOT:-/}" "$DB" >&2
  fi
  "apt-$command"
  exit $?
else
  printf '%s' "$usage"
  exit 1
fi
